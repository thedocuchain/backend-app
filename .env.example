# Wallet balance alerts (Telegram) — dedicated bot/chat, separate from TG_* (feedbacks).
# Leave blank to disable.
WALLET_ALERT_TG_BOT_TOKEN=
WALLET_ALERT_TG_CHAT_ID=
# Optional: hours between repeat alerts while a wallet stays low (default 12)
# WALLET_ALERT_REMIND_HOURS=12
# Optional native-token thresholds (~$1 defaults live in wallet-monitor.service.ts)
# WALLET_ALERT_POLYGON_MIN=5
# WALLET_ALERT_BSC_MIN=0.0015
# WALLET_ALERT_BASE_MIN=0.0004
# WALLET_ALERT_SEI_MIN=4
# WALLET_ALERT_SOLANA_MIN=0.01

